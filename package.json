{
  "name": "@kyc/workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "DS",
    "frontend"
  ],
  "description": "KYC application and design system workspace",
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev:app": "node scripts/run-application.mjs",
    "build": "npm run build --workspace @kyc/ui",
    "build-storybook": "npm run build-storybook --workspace @kyc/ui",
    "storybook": "npm run storybook --workspace @kyc/ui",
    "test": "npm run test --workspace @kyc/ui",
    "typecheck": "npm run typecheck --workspace @kyc/ui",
    "lint": "eslint DS frontend",
    "lint:fix": "eslint DS frontend --fix",
    "quality": "npm run lint && npm run typecheck && npm run check:dependencies && npm test && npm run build",
    "format": "prettier --write DS frontend package.json eslint.config.mjs prettier.config.js",
    "check:dependencies": "dependency-cruiser --config .dependency-cruiser.cjs DS"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/compat": "2.0.2",
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
